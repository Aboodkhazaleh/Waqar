firebase-service-account*.json
service-account*.json
*-firebase-adminsdk-*.json

# Firebase CLI local project pointer (safe to commit but optional)
# .firebaserc

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors
.vscode/
.idea/
*.swp

# OS
Thumbs.db

# Local JSON data (legacy — Firestore replaces this)
/data/

# Bun lock — optional commit (uncomment to keep)
# bun.lock

# Logs
*.log
